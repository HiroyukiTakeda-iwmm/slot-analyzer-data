{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "official-domains.schema.json",
  "title": "Official Maker Domains",
  "description": "メーカーの公式ドメインの一覧（仕様 5.7）。出典記録の kind: official の出典は、URL のサイト（登録ドメイン）がこの一覧にあること。domain が登録ドメインそのもの（www.・サブドメインなし）かと重複は、検証器のコードで確かめる",
  "type": "object",
  "required": ["domains"],
  "additionalProperties": false,
  "properties": {
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain", "maker", "evidence", "checkedAt"],
        "additionalProperties": false,
        "properties": {
          "domain": {
            "type": "string",
            "description": "登録ドメイン（小文字のラベルを「.」でつなぐ。例: sammy.co.jp）",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
          },
          "maker": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "string",
            "description": "そのドメインがメーカーのものだと確かめた、メーカーの会社情報のページ",
            "pattern": "^https://",
            "format": "uri"
          },
          "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" }
        }
      }
    }
  }
}
