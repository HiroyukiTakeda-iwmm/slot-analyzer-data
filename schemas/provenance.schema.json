{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "provenance.schema.json",
  "title": "Machine Data Provenance",
  "description": "機種データの出典記録（仕様: docs/superpowers/specs/2026-09-26-data-expansion-design.md 5章）",
  "type": "object",
  "required": [
    "machineId",
    "machineFile",
    "reviewedAt",
    "sources",
    "items",
    "candidates",
    "removed",
    "retiredIds"
  ],
  "additionalProperties": false,
  "properties": {
    "machineId": { "type": "string", "minLength": 1 },
    "machineFile": { "type": "string", "pattern": "^[^/].*\\.json$" },
    "reviewedAt": { "$ref": "#/definitions/date" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } },
    "items": { "type": "array", "items": { "$ref": "#/definitions/item" } },
    "candidates": { "type": "array", "items": { "$ref": "#/definitions/candidate" } },
    "removed": { "type": "array", "items": { "$ref": "#/definitions/removed" } },
    "retiredIds": { "type": "array", "items": { "$ref": "#/definitions/retiredId" } }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" },
    "sourceKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "kind": {
      "type": "string",
      "enum": [
        "role",
        "zoneRole",
        "confirmationEvent",
        "endScreen",
        "endScreenGroupItem",
        "voiceCount",
        "musicCount",
        "effectCount",
        "trialSuccessRate",
        "modeTransition",
        "specialSettings"
      ]
    },
    "unit": { "type": "string", "enum": ["denominator", "percent", "settings", "presence"] },
    "source": {
      "type": "object",
      "required": ["key", "kind", "url", "retrievedAt"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/definitions/sourceKey" },
        "kind": { "type": "string", "enum": ["analysis-site", "official"] },
        "url": { "type": "string", "pattern": "^https://" },
        "retrievedAt": { "$ref": "#/definitions/date" }
      }
    },
    "settingKeyedNumbers": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[1-6LV]$": {
          "anyOf": [
            { "type": ["number", "null"] },
            { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?%?$" }
          ]
        }
      },
      "additionalProperties": false
    },
    "settingList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[1-6LV]$" }
    },
    "settingSets": {
      "type": "object",
      "required": ["confirmed", "excluded"],
      "additionalProperties": false,
      "properties": {
        "confirmed": { "$ref": "#/definitions/settingList" },
        "excluded": { "$ref": "#/definitions/settingList" }
      }
    },
    "value": {
      "anyOf": [
        { "$ref": "#/definitions/settingKeyedNumbers" },
        { "$ref": "#/definitions/settingSets" },
        { "const": true }
      ]
    },
    "valuesBySource": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/sourceKey" },
      "additionalProperties": { "$ref": "#/definitions/value" }
    },
    "item": {
      "type": "object",
      "required": ["kind", "name", "status", "unit", "values", "adopted"],
      "additionalProperties": false,
      "properties": {
        "kind": { "$ref": "#/definitions/kind" },
        "name": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["confirmed", "provisional-chonborista", "kept-single-source"]
        },
        "unit": { "$ref": "#/definitions/unit" },
        "values": { "allOf": [{ "$ref": "#/definitions/valuesBySource" }, { "minProperties": 1 }] },
        "adopted": { "$ref": "#/definitions/value" },
        "reread": { "$ref": "#/definitions/reread" }
      }
    },
    "reread": {
      "type": "object",
      "required": ["by", "value"],
      "additionalProperties": false,
      "properties": {
        "by": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/definitions/value" }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["kind", "name", "unit", "values", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": { "$ref": "#/definitions/kind" },
        "name": { "type": "string", "minLength": 1 },
        "unit": { "$ref": "#/definitions/unit" },
        "values": { "$ref": "#/definitions/valuesBySource" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "removed": {
      "type": "object",
      "description": "その見直しで外した項目と根拠（仕様 5.2・5.8）。previous は外す前の機種ファイルの項目そのもの、values は調べた出典の値（見つからなければ {}）、appId は main でアプリがその項目に使っていた ID。appId は ID を持つ項目だけに書き、同じ行を retiredIds に足す（検証器が確かめる）。後の PR で消してよい（ID は retiredIds に残る）",
      "required": ["kind", "name", "unit", "previous", "values", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": { "$ref": "#/definitions/kind" },
        "name": { "type": "string", "minLength": 1 },
        "unit": { "$ref": "#/definitions/unit" },
        "previous": { "type": "object" },
        "values": { "$ref": "#/definitions/valuesBySource" },
        "appId": { "type": "string", "minLength": 1 },
        "reread": { "$ref": "#/definitions/reread" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "retiredId": {
      "type": "object",
      "description": "外した ID の台帳の1行（仕様 5.8）。足すだけで、消さない・書き換えない（main と比べる検査が確かめる）。今の機種ファイルの ID を持つ項目は、同じ範囲でこの appId を使えない（検証器が確かめる）",
      "required": ["kind", "name", "appId"],
      "additionalProperties": false,
      "properties": {
        "kind": { "$ref": "#/definitions/kind" },
        "name": { "type": "string", "minLength": 1 },
        "appId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
